# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.env

# HF / parse caches and intermediate data
/tmp_hf_cache/
data/parsed/*_upstage.jsonl
!data/parsed/.gitkeep
# Whitelist the final first-100-query parse caches used by run_today_ppt_pipeline.sh.
# These ~3.7 MB of JSONL guarantee a fresh clone can re-generate the PPT table
# without re-calling the Upstage API.
!data/parsed/*_first100_qrels_upstage.jsonl

# Results: generated artifacts can be very large; keep the directory but track only summaries.
results/visrag_retrieval/*
results/visrag_generation/*
results/v12_on_visrag/smoke/
!results/.gitkeep
!results/comparison_summary_dryrun.json
!results/domain_free_v12_summary_dryrun.json

# Vendored repos / large blobs
# visrag is just a shallow clone of openbmb/visrag - keep it out of our git history.
visrag/

# Editor
.idea/
.vscode/
.DS_Store
run_today*.log
